# Firebase Web App config (public, not secret). Copy to .env.local and fill in.
# English Detective shares Firebase Auth with English City Simulator (project k26game1).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=k26game1.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=k26game1
VITE_FIREBASE_APP_ID=

# Local development against the Firebase Auth emulator (npm run emulators).
# When true and no API key is set, the app uses apiKey "fake-api-key" and projectId "demo-ed".
VITE_USE_AUTH_EMULATOR=true
