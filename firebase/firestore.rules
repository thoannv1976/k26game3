rules_version = '2';

// English Detective – Firestore Security Rules (database "detective")
//
// The web app reads and writes ALL data through the backend API (Cloud Run, Admin SDK),
// which bypasses these rules and enforces roles itself. Rules are defence in depth:
//  - no client can write anything;
//  - case dossiers (answers, character facts, solutions) are never readable by clients;
//  - a user may read only their own profile, sessions, reports and assessments;
//  - school admins may read their own school's learning data; nobody reads another school.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function inTenant(t) { return signedIn() && request.auth.token.tenantId == t; }
    function roleOf() { return request.auth.token.role; }
    function isSchoolAdmin(t) { return inTenant(t) && roleOf() == 'school_admin'; }

    match /tenants/{t} {
      allow read: if isSchoolAdmin(t);
      allow write: if false;

      match /users/{uid} {
        allow read: if inTenant(t) && (request.auth.uid == uid || roleOf() == 'school_admin');
        allow write: if false;
      }

      // Case metadata only; versions hold the canonical dossier and are server-only.
      match /cases/{caseId} {
        allow read: if inTenant(t) && roleOf() in ['teacher', 'school_admin'];
        allow write: if false;
        match /versions/{v} {
          allow read, write: if false;
        }
      }

      match /investigation_sessions/{sid} {
        allow read: if inTenant(t) && (resource.data.uid == request.auth.uid || roleOf() == 'school_admin');
        allow write: if false;
        match /{sub=**} {
          allow read: if inTenant(t) && (
            roleOf() == 'school_admin' ||
            get(/databases/$(database)/documents/tenants/$(t)/investigation_sessions/$(sid)).data.uid == request.auth.uid
          );
          allow write: if false;
        }
      }

      match /final_reports/{sid} {
        allow read: if inTenant(t) && (resource.data.uid == request.auth.uid || roleOf() == 'school_admin');
        allow write: if false;
      }

      match /assessments/{aid} {
        allow read: if inTenant(t) && (resource.data.uid == request.auth.uid || roleOf() == 'school_admin');
        allow write: if false;
      }

      match /{collection}/{doc} {
        allow read: if isSchoolAdmin(t) && collection in ['courses', 'assignments', 'usage_counters', 'usage_logs', 'audit_logs'];
        allow write: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
