rules_version = '2';

// VSTEP Quest – Firestore Security Rules (database "vstep")
//
// The web app reads and writes ALL data through the backend API (Cloud Run, Admin SDK), which bypasses these
// rules and enforces roles, timing and answer visibility itself. Rules are defence in depth:
//  - no client can write anything;
//  - the question bank, quests, mock exams and attempt state (answers, keys, scripts, sample answers) are server-only;
//  - a user may read only their own profile and their own assessments; school admins read their own school's results;
//  - nobody reads another school's data.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function inTenant(t) { return signedIn() && request.auth.token.tenantId == t; }
    function roleOf() { return request.auth.token.role; }
    function isSchoolAdmin(t) { return inTenant(t) && roleOf() == 'school_admin'; }

    match /tenants/{t} {
      allow read: if isSchoolAdmin(t);
      allow write: if false;

      match /users/{uid} {
        allow read: if inTenant(t) && (request.auth.uid == uid || roleOf() == 'school_admin');
        allow write: if false;
      }

      match /assessments/{id} {
        allow read: if inTenant(t) && (resource.data.uid == request.auth.uid || roleOf() == 'school_admin');
        allow write: if false;
      }

      // Everything else (question_bank, quests, mock_exams, exam_blueprints, game_sessions and their
      // writing_submissions/explanations, championships, learning_profiles, usage, audit) is server-only.
      match /{document=**} {
        allow read, write: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
