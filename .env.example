# API (apps/api) – local runs, or Cloud Run env vars. No secret keys: Google APIs use the service account (ADC).
NODE_ENV=development
PORT=8080
GCP_PROJECT_ID=k26game1
# VSTEP Quest uses its own Firestore database in the shared project (Game 1: (default), Game 2: detective).
FIRESTORE_DATABASE=vstep

# vertex | fake  ("fake" = offline provider for development/tests only – refused when NODE_ENV=production)
AI_PROVIDER=fake
# Model/location verified for the K26 project (Game 1 deployment): gemini-2.5-flash returned 404 there.
GEMINI_MODEL=gemini-3-flash-preview
VERTEX_LOCATION=global
AI_TIMEOUT_MS=20000
GRADING_TIMEOUT_MS=60000
AI_MAX_RETRIES=2
RATE_LIMIT_PER_MINUTE=300

# Speech: google | fake. Blob store: gcs | local | memory (production: google + gcs)
SPEECH_PROVIDER=fake
TTS_PROVIDER=fake
BLOB_STORE=local
LOCAL_DATA_DIR=.data
AUDIO_BUCKET=k26game1-vstep-audio
STT_MODEL=latest_long
STT_LANGUAGE=en-US

# Cloud Scheduler → /internal/jobs/tick (OIDC). Empty JOBS_INVOKERS = allowed only outside production.
JOBS_INVOKERS=
JOBS_AUDIENCE=

# D4 (optional): read-only learning evidence from Game 1 / Game 2 (their Cloud Run URLs)
PEER_CITY_URL=
PEER_DETECTIVE_URL=
PEER_AUDIENCE=k26-lms

# UniGame Hub (LTI 1.3 SSO + Moodle grade sync). Off by default.
LTI_ENABLED=false
LTI_HUB_URL=https://unigame-hub-423573033950.asia-southeast1.run.app
LTI_GAME_ID=k26game3
# Hub tenant -> this app's tenant, "hubTenant=appTenant;other=x"
LTI_TENANT_MAP=
# From Secret Manager in production (secret: unigamehub-secret-k26game3)
LTI_GAME_SECRET=

# Local emulators (set automatically by "firebase emulators:exec")
FIRESTORE_EMULATOR_HOST=127.0.0.1:8085
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

BLOCKED_TERMS=
LOG_LEVEL=debug
